# Copy to .env (never commit that one) and fill it in. Used by compose.prod.yaml.

# The name the apps use to reach the server, with a certificate for it in nginx/certs/
# (see nginx/certs/README.md). For example: api.example.com
PIN_DOMAIN=

# The database password. Long and random, for example: openssl rand -base64 32
PIN_DB_PASSWORD=

# The first admin for the admin panel, created on start. Leave the email empty to add none.
# The password needs at least 12 characters. Change it by changing it here and restarting.
PIN_ADMINACCOUNT_EMAIL=
PIN_ADMINACCOUNT_PASSWORD=
PIN_ADMINACCOUNT_NAME=Pin admin
